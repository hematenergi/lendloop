# Next.js local runtime (.env.local)
# Clerk publishable key from the Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment env (set with npx convex env set, not in Next.js)
WEBHOOK_HMAC_SECRET=
N8N_REQUEST_WEBHOOK_URL=
CONVEX_HTTP_SECRET=
ADMIN_CLERK_IDS=

# Docker Compose n8n env (.env at the repo root); the two shared secrets above
# must match the corresponding Convex deployment values.
N8N_ENCRYPTION_KEY=
CONVEX_SITE_URL=
