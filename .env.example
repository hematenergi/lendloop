# Clerk publishable key from the Clerk application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key from the Clerk application.
CLERK_SECRET_KEY=
# Local sign-in route.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Local sign-up route.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public URL of the Convex deployment.
NEXT_PUBLIC_CONVEX_URL=

# Convex deployment env (set via n8n/Convex dashboard, not .env.local)
# Shared HMAC secret for Convex and n8n.
WEBHOOK_HMAC_SECRET=
# n8n request-event webhook URL.
N8N_REQUEST_WEBHOOK_URL=
# Bearer secret for the overdue HTTP endpoint.
CONVEX_HTTP_SECRET=
# Comma-separated Clerk subject IDs allowed to administer LendLoop.
ADMIN_CLERK_IDS=
