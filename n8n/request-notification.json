        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "7d3879a0-1877-4e01-99cf-d3215ec9e1d6",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
