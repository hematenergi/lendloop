      },
      "id": "8c2cb58a-2077-4d2d-bff6-e074114ed1e0",
      "name": "Already processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        180
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst body = input.body;\nconst verb = body.type === \"request.created\" ? \"requested\" : \"updated\";\nconst subject = \"LendLoop: \" + body.type + \" — \" + body.item.name;\nconst text = \"Hi \" + body.recipient.name + \", \" + body.actor.name + \" \" + verb + \" your \" + body.item.name + \" (\" + body.request.startDate + \" → \" + body.request.endDate + \"). Status: \" + body.request.status + \".\";\nreturn [{ json: { ...input, subject, text } }];"
      },
      "id": "fafbb3cc-fcd0-45c7-86e4-bb8873a4954e",
      "name": "Format notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: {\n  to: $json.body.recipient.email,\n  subject: $json.subject,\n  text: $json.text,\n  eventId: $json.eventId,\n  sentAt: new Date().toISOString()\n} }];"
      },
