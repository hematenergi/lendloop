        0,
        300
      ],
      "webhookId": "e51a3987-57bb-48e1-9d52-213f30585ea2"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require(\"crypto\");\nconst input = $input.first().json;\nconst body = input.body;\nconst headers = input.headers || {};\nconst rawBody = input.rawBody ?? JSON.stringify(body);\nconst secret = $env.WEBHOOK_HMAC_SECRET;\nconst headerSignature = String(headers[\"x-lendloop-signature\"] ?? headers[\"X-LendLoop-Signature\"] ?? \"\");\nconst supplied = headerSignature.startsWith(\"sha256=\") ? headerSignature.slice(7) : \"\";\nconst expected = typeof rawBody === \"string\" && secret\n  ? crypto.createHmac(\"sha256\", secret).update(rawBody, \"utf8\").digest(\"hex\")\n  : \"\";\nfunction constantTimeEqual(left, right) {\n  let mismatch = left.length ^ right.length;\n  for (let i = 0; i < Math.max(left.length, right.length); i += 1) {\n    mismatch |= (left.charCodeAt(i) || 0) ^ (right.charCodeAt(i) || 0);\n  }\n  return mismatch === 0;\n}\nconst headerEventId = String(headers[\"x-lendloop-event-id\"] ?? headers[\"X-LendLoop-Event-Id\"] ?? \"\");\nconst verified = Boolean(secret && expected && headerSignature.startsWith(\"sha256=\") && body && typeof body.eventId === \"string\" && body.eventId === headerEventId && constantTimeEqual(expected, supplied));\nreturn [{ json: { ...input, body, verified } }];"
      },
      "id": "e8575587-5838-4dff-a1bf-563bded05ee1",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3c2d7df-9cdc-42a3-9391-855a659ead3f",
              "leftValue": "={{ $json.verified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f04b0a00-3a9b-4dd1-8132-c4ea657996ef",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const data = $getWorkflowStaticData(\"global\");\ndata.processedEventIds = data.processedEventIds || {};\nconst eventId = $json.body.eventId;\nconst duplicate = Boolean(data.processedEventIds[eventId]);\nif (!duplicate) data.processedEventIds[eventId] = new Date().toISOString();\nreturn [{ json: { ...$json, eventId, duplicate } }];"
      },
      "id": "3ccda872-2921-4cec-92a0-bc144d089298",
